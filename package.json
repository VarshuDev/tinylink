{
  "name": "url-shortener",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build:pages": "esbuild src/index.ts --bundle --format=esm --platform=browser --target=es2022 --outfile=dist/_worker.js",
    "deploy:pages": "npm run build:pages && wrangler pages deploy dist --project-name=tinylink --branch=main",
    "tail": "wrangler tail",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240109.0",
    "typescript": "^5.3.3",
    "vitest": "^5.1.1",
    "wrangler": "^3.35.0"
  },
  "dependencies": {
    "qrcode": "^1.5.3"
  }
}
